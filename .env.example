# Google Sheets Configuration
VITE_SPREADSHEET_ID=your_spreadsheet_id_here
VITE_GOOGLE_API_KEY=your_api_key_here

# Supabase Configuration (optional alternative to Google Sheets)
VITE_SUPABASE_URL=https://xxxxxxxx.supabase.co
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key_here

# Rep Signup Controls (Supabase mode)
# - Managers should not self-signup; create manager users in Supabase.
# - Rep signups are enforced via the Supabase `rep_allowlist` table (managed from the Manager dashboard).
VITE_REP_SIGNUP_ENABLED=true

# Testing only: bypass the weekly submission lock screen.
VITE_DISABLE_SUBMISSION_LOCK=false

# Manager XLSX Exports (server-side)
# These routes require an authenticated manager:
# - GET /manager/export/rep-table
# - GET /manager/export/availability?start_date=YYYY-MM-DD&end_date=YYYY-MM-DD
#
# Templates are optional but recommended to ensure exact header/order and any formatting.
# If provided, the export will load the template and populate rows.
EXPORT_REP_TEMPLATE_PATH=/absolute/path/to/rep_table_v4_hours.xlsx
EXPORT_AVAIL_TEMPLATE_PATH=/absolute/path/to/availability_v4_forced_6h.xlsx

# Availability time window (stored as strings in the XLSX)
EXPORT_AVAIL_START_TIME=08:00
EXPORT_AVAIL_END_TIME=20:00

# Rep geocoding (server-side, manager-only)
# Default uses OpenStreetMap Nominatim (free; follow usage policy / rate limits).
GEOCODER_BASE_URL=https://nominatim.openstreetmap.org
GEOCODER_USER_AGENT=pc-availability-app/1.0
