{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "framework": "vite",
  "rewrites": [
    {
      "source": "/manager/export/rep-table",
      "destination": "/api/manager/export/rep-table"
    },
    {
      "source": "/manager/export/availability",
      "destination": "/api/manager/export/availability"
    },
    {
      "source": "/manager/reps",
      "destination": "/api/manager/reps"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
